 "gatesOut": false,
 "probe": "\nconst s = ws.samples.find(x => x.name === 'Specimen_001_C7_C07 Negative.fcs');\nconst live = rep.paths['Lymphocytes/Single Cells 1/Single Cells 2/Comp-LIVE_DEAD Aqua-A, SSC-A subset'];\nconst par = rep.paths['Lymphocytes/Single Cells 1/Single Cells 2'];\nconst g = ws.gate(live);\nconst pidx = ws.indices(s, par);\nconst direct = FM.gating.filter(FM.gating.gateFor(g, s.key), s, pidx).length;\nconst dx = FM.transforms.displayColumn(s, g.x, g.xScale), dy = FM.transforms.displayColumn(s, g.y, g.yScale);\nconst X = FM.transforms.makeScale(g.xScale), Y = FM.transforms.makeScale(g.yScale);\nconst dv = g.verts.map(([a, b]) => [X.fwd(a), Y.fwd(b)]);\nconst e = 145;\nreturn { engineCount: ws.count(s, live), directFilter: direct, parent: pidx.length, inParent145: Array.from(pidx).includes(e),\n  data145: [s.data[g.x][e], s.data[g.y][e]], disp145: [dx[e], dy[e]], fresh145: [X.fwd(s.data[g.x][e]), Y.fwd(s.data[g.y][e])],\n  dispVerts: dv, pip: FM.gating.pointInPolygon(dx[e], dy[e], dv.map(p => p[0]), dv.map(p => p[1])), compensated: s.compensated, gateKeys: Object.keys(g) };\n"
